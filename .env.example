# DocuMate settings.
#
# Copy this file to .env in the project folder and fill in the values:
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (bash)
#
# .env is listed in .gitignore, so it is never committed. This template IS
# committed, so never put a real password in this file.
#
# .env is read automatically when python-dotenv is installed. Without it,
# DocuMate reads the same names from your environment variables instead:
#
#     setx DOCUMATE_DB_PASSWORD "your-password"      (Windows, new shells)
#     export DOCUMATE_DB_PASSWORD="your-password"    (bash)
#
# Check what DocuMate picked up with:   python main.py --check


# --- Database, for versions Z and O ----------------------------------------
# DOCUMATE_DB_BACKEND chooses the database:
#
#     azuresql   Azure SQL Database   needs pyodbc     port 1433   (default)
#     postgres   PostgreSQL           needs psycopg2   port 5432
#
# The settings below have the same names for both, so switching database
# only means changing this one line. Leave DOCUMATE_DB_PORT unset to use the
# backend's default port.

DOCUMATE_DB_BACKEND=azuresql

# Required for both backends. If one is missing, DocuMate stops at the start
# and names the missing setting.

DOCUMATE_DB_HOST=
DOCUMATE_DB_NAME=
DOCUMATE_DB_USER=
DOCUMATE_DB_PASSWORD=
# DOCUMATE_DB_PORT=

# The schema holding the DocuMate tables. Leave unset to use the connection's
# default (dbo on Azure SQL, public on PostgreSQL). Set it if the tables are
# in another schema; the usual sign is an "Invalid object name" error.
# DOCUMATE_DB_SCHEMA=

# Azure SQL setup:
#   - HOST is <server-name>.database.windows.net
#     (Azure portal -> your SQL server -> Overview)
#   - Allow your client IP under Security -> Networking, or the connection
#     is refused.
#   - Install Microsoft ODBC Driver 18 for SQL Server as well as pyodbc.
#   - Encryption is always on; there is no sslmode setting.

# PostgreSQL only: SSL mode, default "require".
# DOCUMATE_DB_SSLMODE=require

# Supabase: the direct db.<project-ref>.supabase.co host needs IPv6 (or the
# paid IPv4 add-on). On an IPv4-only network, use the Session pooler host
# from Project Settings -> Database -> Connection string. With the pooler,
# the user becomes postgres.<project-ref>.


# --- Excel, for versions v3, X and Y ---------------------------------------
# Both optional. The defaults are files/data/DocuMate_DataFrame.xlsx and the
# sheet DocuMateSRC.

# DOCUMATE_EXCEL_PATH=
# DOCUMATE_SHEET_NAME=DocuMateSRC


# --- Other -----------------------------------------------------------------
# Project folder override. Normally leave unset: DocuMate finds the project
# folder from where it is running. Useful for testing.

# DOCUMATE_ROOT=

# Set to 0 to print messages in the console instead of Windows popups.
# Popups are always off when not running on Windows.

# DOCUMATE_POPUPS=1
