# DocuMate database settings.
#
# Copy this file to .env and fill in the password. .env is gitignored;
# this template is not, so never put the real password in here.
#
#     cp .env.example .env
#
# Only the password is read from here. Host, database, user and port are
# ordinary literals in src/DocuMateZ.py, src/DocuMateO.py and
# src/loadData.py -- they are not secrets, so edit them there.
#
# Loaded automatically when python-dotenv is installed. Without it this
# file is ignored and the value falls back to a real environment
# variable, so exporting it in your shell works too:
#
#     setx DOCUMATE_DB_PASSWORD "your-password"      (Windows, new shells)
#     export DOCUMATE_DB_PASSWORD="your-password"    (bash)

DOCUMATE_DB_PASSWORD=

# Supabase note: the direct db.<project-ref>.supabase.co host needs IPv6,
# or the paid IPv4 add-on. On an IPv4-only network use the Session pooler
# host from Project Settings -> Database -> Connection string instead.
# The pooler also changes the user to postgres.<project-ref>.
