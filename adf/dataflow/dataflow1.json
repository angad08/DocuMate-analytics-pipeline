{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DocumateExcel",
						"type": "DatasetReference"
					},
					"name": "ApplicantBranch"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DocuMate_MHA",
						"type": "DatasetReference"
					},
					"name": "SinkMHA"
				},
				{
					"dataset": {
						"referenceName": "DocuMate_Applicants",
						"type": "DatasetReference"
					},
					"name": "SinkApplicant"
				}
			],
			"transformations": [
				{
					"name": "selectMHA"
				},
				{
					"name": "UpsertMHA"
				},
				{
					"name": "SelectApplicant"
				},
				{
					"name": "UpsertApplicant"
				}
			],
			"scriptLines": [
				"source(output(",
				"          File_Number as string,",
				"          Name as string,",
				"          Sex as string,",
				"          Birth_Date as date 'yyyy-MM-dd',",
				"          Place as string,",
				"          State as string,",
				"          Name_Of_Father as string,",
				"          Name_Of_Mother as string,",
				"          Address_line_1 as string,",
				"          Address_line_2 as string,",
				"          Address_line_3 as string,",
				"          Registration_Date as date 'yyyy-MM-dd',",
				"          MHA_FILE_NUMBER as string,",
				"          MHA_DATE as date 'yyyy-MM-dd',",
				"          ib_staff_authority_id as string,",
				"          Signing_Authority as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ApplicantBranch",
				"ApplicantBranch select(mapColumn(",
				"          mha_file_number = MHA_FILE_NUMBER,",
				"          mha_date = MHA_DATE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectMHA",
				"selectMHA alterRow(upsertIf(true())) ~> UpsertMHA",
				"ApplicantBranch select(mapColumn(",
				"          File_Number,",
				"          Name,",
				"          Sex,",
				"          Birth_Date,",
				"          Place,",
				"          state_code = State,",
				"          Name_Of_Father,",
				"          Name_Of_Mother,",
				"          Address_line_1,",
				"          Address_line_2,",
				"          Address_line_3,",
				"          Registration_Date,",
				"          MHA_FILE_NUMBER,",
				"          ib_staff_authority_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectApplicant",
				"SelectApplicant alterRow(upsertIf(true())) ~> UpsertApplicant",
				"UpsertMHA sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          mha_file_number as string,",
				"          mha_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['mha_file_number'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkMHA",
				"UpsertApplicant sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          file_number as string,",
				"          serial as integer,",
				"          name as string,",
				"          sex as string,",
				"          birth_date as date,",
				"          place as string,",
				"          state_code as string,",
				"          name_of_father as string,",
				"          name_of_mother as string,",
				"          address_line_1 as string,",
				"          address_line_2 as string,",
				"          address_line_3 as string,",
				"          registration_date as date,",
				"          status as string,",
				"          date_issued as date,",
				"          mha_file_number as string,",
				"          ib_staff_authority_id as string",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['file_number'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          file_number = File_Number,",
				"          name = Name,",
				"          sex = Sex,",
				"          birth_date = Birth_Date,",
				"          place = Place,",
				"          state_code,",
				"          name_of_father = Name_Of_Father,",
				"          name_of_mother = Name_Of_Mother,",
				"          address_line_1 = Address_line_1,",
				"          address_line_2 = Address_line_2,",
				"          address_line_3 = Address_line_3,",
				"          registration_date = Registration_Date,",
				"          mha_file_number = MHA_FILE_NUMBER,",
				"          ib_staff_authority_id",
				"     )) ~> SinkApplicant"
			]
		}
	}
}