{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "ApplicantBranch"
				}
			],
			"sinks": [
				{
					"name": "SinkMHA"
				},
				{
					"name": "SinkApplicant"
				}
			],
			"transformations": [
				{
					"name": "selectMHA"
				},
				{
					"name": "UpsertMHA"
				},
				{
					"name": "SelectApplicant"
				},
				{
					"name": "UpsertApplicant"
				}
			],
			"scriptLines": [
				"source(output(",
				"          File_Number as string,",
				"          Name as string,",
				"          Sex as string,",
				"          Birth_Date as date 'yyyy-MM-dd',",
				"          Place as string,",
				"          State as string,",
				"          Name_Of_Father as string,",
				"          Name_Of_Mother as string,",
				"          Address_line_1 as string,",
				"          Address_line_2 as string,",
				"          Address_line_3 as string,",
				"          Registration_Date as date 'yyyy-MM-dd',",
				"          MHA_FILE_NUMBER as string,",
				"          MHA_DATE as date 'yyyy-MM-dd',",
				"          ib_staff_authority_id as string,",
				"          Signing_Authority as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> ApplicantBranch",
				"ApplicantBranch select(mapColumn(",
				"          mha_file_number = MHA_FILE_NUMBER,",
				"          mha_date = MHA_DATE",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectMHA",
				"selectMHA alterRow(upsertIf(true())) ~> UpsertMHA",
				"ApplicantBranch select(mapColumn(",
				"          File_Number,",
				"          Name,",
				"          Sex,",
				"          Birth_Date,",
				"          Place,",
				"          state_code = State,",
				"          Name_Of_Father,",
				"          Name_Of_Mother,",
				"          Address_line_1,",
				"          Address_line_2,",
				"          Address_line_3,",
				"          Registration_Date,",
				"          MHA_FILE_NUMBER,",
				"          ib_staff_authority_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectApplicant",
				"SelectApplicant alterRow(upsertIf(true())) ~> UpsertApplicant",
				"UpsertMHA sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     format: 'table') ~> SinkMHA",
				"UpsertApplicant sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 2,",
				"     mapColumn(",
				"          file_number = File_Number,",
				"          name = Name,",
				"          sex = Sex,",
				"          birth_date = Birth_Date,",
				"          place = Place,",
				"          state_code,",
				"          name_of_father = Name_Of_Father,",
				"          name_of_mother = Name_Of_Mother,",
				"          address_line_1 = Address_line_1,",
				"          address_line_2 = Address_line_2,",
				"          address_line_3 = Address_line_3,",
				"          registration_date = Registration_Date,",
				"          mha_file_number = MHA_FILE_NUMBER,",
				"          ib_staff_authority_id",
				"     ),",
				"     format: 'table') ~> SinkApplicant"
			]
		}
	}
}