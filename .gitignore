# Secrets - config.env holds the database password, so it is never
# committed. The old names are kept out too, in case one is lying around.
config.env
.env
.env.local
DocuMate_env
env
env.txt

# Python cache
__pycache__/
*.pyc

# Virtual environments
venv/
env/
.venv/

# IDE and local tool settings
.vscode/
.idea/
.claude/

# Build artifacts
dist/
build/
*.exe
*.spec

# Generated outputs.
# Generated documents are at files/output/.
files/output/*
!files/output/.gitkeep

# The files chosen last run - paths on this machine, nobody else's.
files/last_run.json

# The real birth register. Never commit it under any name - it is the
# live consular data, not the synthetic demo workbook.
BIRTH_REGISTRATION*.xlsx

# Power BI files embed a full copy of their data model, so a .pbix can
# carry the whole applicant table inside it even when the report only
# shows counts.
*.pbix

# Temp files the Mail Merge engine writes while Word is running.
# Cleaned up automatically, but listed in case a run is interrupted -
# they contain real personal data.
__temp_merge_source.csv
__temp_batch_*.docx

# OS files
Thumbs.db
.DS_Store
