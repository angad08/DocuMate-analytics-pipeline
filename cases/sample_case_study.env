# Sample case study - student results, the worked example in files\.
#
# Run it with:   python main.py v3 sample_case_study
# Written like config.env: one setting per line. Leave a line out, or
# blank, and DocuMate asks for it or skips that check.


# --- Files -----------------------------------------------------------------------
DOCUMATE_EXCEL_PATH=SAMPLE_CASE_STUDY.xlsx
DOCUMATE_SHEET_NAME=Students
DOCUMATE_TEMPLATE=SAMPLE_CASE_STUDY.docx
DOCUMATE_ID_COLUMN=Roll No


# --- Checks: a row that breaks one is listed, and nothing is made ----------------

# These columns can never be blank.
MUST_FILL=Roll No, Student Name, Course, Marks, Grade

# The same value may not appear on two rows.
NO_REPEATS=Roll No

# Only these values may be typed. One column per part, separated by ;
ALLOWED=Grade: A, B, C, D, E, F

# Must be a readable date (03/04/2025 is the 3rd of April). Printed dd/mm/yyyy.
DATES=Exam Date
