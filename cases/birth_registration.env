# Birth registration - certificates from the birth register.
#
# Run it with:   python main.py v3 birth_registration
#          or:   python main.py dabba birth_registration
#          or:   python main.py x birth_registration      (Word Mail Merge)
#
# Written like config.env: one setting per line. Leave a line out, or
# blank, and DocuMate asks for it or skips that check.


# --- Files -----------------------------------------------------------------------
# A file name is looked for in files\data (Excel) or files\templates (Word).
DOCUMATE_EXCEL_PATH=BIRTH_REGISTRATION_2026.xlsx
DOCUMATE_SHEET_NAME=Sheet1
DOCUMATE_TEMPLATE=BIRTH_REG_FORMAT.docx
DOCUMATE_TEMPLATE_MM=BIRTH_REG_FORMAT_MM.docx
DOCUMATE_OUTPUT_NAME=BR


# --- Checks ------------------------------------------------------------------------
# The birth register is recognised by its headings and already checks, on
# its own:
#   - every column is filled in, except ADD 2 and ADD 3
#   - dates can be read (03/04/2025 is the 3rd of April)
#   - Sex is F or M, and a signing authority is named
#   - no File No appears twice
#
# The lines below add to that. Because the register's columns are turned into
# certificate fields first, they use the certificate's names: Serial,
# File_Number, Name, Sex, Registration_date...

# The registration number may not appear twice.
NO_REPEATS=Serial

# Every file number starts AU (all 1,556 rows in the 2026 register do).
STARTS_WITH=File_Number: AU
